# ==========================================
# XSX-Live Environment Configuration
# ==========================================

# Your Xbox Series X / S local network IP address
XBOX_IP=192.168.1.180

# Service Bind IP on the host machine (0.0.0.0 for all interfaces)
BIND_IP=0.0.0.0

# Dashboard binding address (IP:PORT)
DASHBOARD_BIND=0.0.0.0:8099

# Base HTTP URL for streaming playback accessed by clients/browsers
# Example: http://<YOUR_SERVER_IP>:8888
MEDIA_HTTP_BASE=http://127.0.0.1:8888

# SRS RTMP ingestion destination
OUTPUT_RTMP=rtmp://127.0.0.1:1935/live/xsx
